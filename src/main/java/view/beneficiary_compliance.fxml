<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" stylesheets="@beneficiary_compliance.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ka4piece.controller.BeneficiaryDashboardController">

    <!-- TOP NAVIGATION BAR -->
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="65.0" styleClass="navbar">
                    <children>
                        <ImageView fitHeight="24.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@/ka4piece_logo.png" />
                            </image>
                            <HBox.margin>
                                <Insets left="15.0" />
                            </HBox.margin>
                        </ImageView>

                        <Region prefHeight="65.0" prefWidth="90.0" HBox.hgrow="ALWAYS" />

                        <!-- NAV TABS IN CENTER -->
                        <HBox alignment="CENTER" spacing="30.0">
                            <children>
                                <Button styleClass="nav-tab, active-tab" text="Compliance" />
                                <Button onAction="#goToJobMatches" styleClass="nav-tab" text="Job Matches" />
                            </children>
                        </HBox>

                        <Region prefHeight="65.0" prefWidth="90.0" HBox.hgrow="ALWAYS" />

                        <!-- PROFILE ICON & LOGOUT BUTTON -->
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#handleOpenViewProfile" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                                    <graphic>
                                        <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@/profile_icon.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <Button onAction="#handleLogout" styleClass="btn-outline" text="↳ Logout">
                                    <padding>
                                        <Insets bottom="6.0" left="12.0" right="12.0" top="6.0" />
                                    </padding>
                                </Button>
                            </children>
                            <HBox.margin>
                                <Insets right="15.0" />
                            </HBox.margin>
                        </HBox>

                    </children>
                </HBox>
                <Separator prefWidth="1280.0" />
            </children>
        </VBox>
    </top>

    <!-- MAIN COMPLIANCE CONTENT -->
    <center>
        <VBox spacing="20.0" style="-fx-background-color: #f8fafc;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="25.0" />
            </padding>
            <children>
                <!-- HEADER TITLE -->
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="page-title" text="Compliance" />
                        <Label styleClass="page-subtitle" text="Review personalized job recommendations based on your profile." />
                    </children>
                </VBox>

                <!-- ASSESSMENT PERIOD BAR -->
                <HBox alignment="CENTER_LEFT" styleClass="assessment-bar">
                    <padding>
                        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                    </padding>
                    <children>
                        <Label styleClass="assessment-label" text="📅  ASSESSMENT PERIOD" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="cmbAssessmentPeriod" prefWidth="180.0" promptText="August 2026" />
                    </children>
                </HBox>

                <HBox spacing="20.0">
                    <!-- COMPLIANCE CONDITIONS (LEFT SIDE) -->
                    <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label styleClass="section-title" text="Compliance Conditions" />

                            <!-- ROW 1 -->
                            <HBox spacing="15.0">
                                <children>
                                    <HBox prefWidth="350.0" styleClass="condition-card, pass-card" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label styleClass="icon-check" text="✔" />
                                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="condition-title" text="PREGNANCY CARE" />
                                                    <Label styleClass="condition-desc" text="Attended scheduled health center visit and vaccination." wrapText="true" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <HBox prefWidth="350.0" styleClass="condition-card, pass-card" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label styleClass="icon-check" text="✔" />
                                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="condition-title" text="DEWORMING (6-14YRS)" />
                                                    <Label styleClass="condition-desc" text="Received deworming pills at school." wrapText="true" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                </children>
                            </HBox>

                            <!-- ROW 2 -->
                            <HBox spacing="15.0">
                                <children>
                                    <HBox prefWidth="350.0" styleClass="condition-card, pass-card" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label styleClass="icon-check" text="✔" />
                                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="condition-title" text="SCHOOL ATTENDANCE" />
                                                    <Label styleClass="condition-desc" text="Maintained &gt;85% monthly attendance rate." wrapText="true" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <HBox prefWidth="350.0" styleClass="condition-card, fail-card" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label styleClass="icon-cross" text="✖" />
                                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="condition-title-fail" text="FAMILY DEVELOPMENT SESSION" />
                                                    <Label styleClass="condition-desc" text="Missed the monthly mandatory FDS meeting." wrapText="true" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                </children>
                            </HBox>

                            <!-- ROW 3 -->
                            <HBox spacing="15.0">
                                <children>
                                    <HBox prefWidth="350.0" styleClass="condition-card, pass-card" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label styleClass="icon-check" text="✔" />
                                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="condition-title" text="NUTRITION MONITORING" />
                                                    <Label styleClass="condition-desc" text="Completed monthly weight/height measurement." wrapText="true" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <HBox prefWidth="350.0" styleClass="condition-card, pass-card" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label styleClass="icon-check" text="✔" />
                                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="condition-title" text="PRE/POST NATAL CARE" />
                                                    <Label styleClass="condition-desc" text="N/A (No current pregnancy in household)." wrapText="true" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                    <!-- SIDEBAR BREAKDOWN & NOTICE (RIGHT SIDE) -->
                    <VBox prefWidth="320.0" spacing="15.0">
                        <children>
                            <!-- GRANT BREAKDOWN CARD -->
                            <VBox spacing="12.0" styleClass="side-card">
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                </padding>
                                <children>
                                    <Label styleClass="side-card-title" text="Grant Breakdown" />
                                    <Separator />
                                    <HBox>
                                        <children>
                                            <Label styleClass="grant-label" text="Health Grant" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label styleClass="grant-value" text="₱750.00" />
                                        </children>
                                    </HBox>
                                    <HBox>
                                        <children>
                                            <Label styleClass="grant-label" text="Education Grant" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label styleClass="grant-value" text="₱1,000.00" />
                                        </children>
                                    </HBox>
                                    <HBox>
                                        <children>
                                            <Label styleClass="grant-label" text="Rice Subsidy" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label styleClass="grant-value" text="₱600.00" />
                                        </children>
                                    </HBox>
                                    <Separator />
                                    <HBox alignment="CENTER_LEFT">
                                        <children>
                                            <Label styleClass="total-label" text="TOTAL AMOUNT" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label styleClass="total-value" text="₱2,350" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <!-- WITHHELD GRANTS NOTICE -->
                            <VBox spacing="10.0" styleClass="side-card">
                                <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                </padding>
                                <children>
                                    <Label styleClass="notice-title" text="ⓘ WITHHELD GRANTS NOTICE" />
                                    <VBox styleClass="notice-box">
                                        <padding>
                                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                        </padding>
                                        <children>
                                            <Label styleClass="notice-text" text="Reason: Non-compliance with Family Development Session (FDS) attendance for the current period. A portion of the grant associated with FDS compliance has been temporarily withheld pending review or make-up session." wrapText="true" />
                                        </children>
                                    </VBox>
                                </children>
                            </VBox>
                        </children>
                    </VBox>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>