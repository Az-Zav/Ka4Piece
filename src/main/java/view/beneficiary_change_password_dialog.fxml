<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefWidth="440.0" spacing="20.0" styleClass="modal-card" stylesheets="@beneficiary_change_password_dialog.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ka4piece.controller.BeneficiaryChangePasswordController">
    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
    </padding>
    <children>

        <!-- HEADER -->
        <VBox spacing="4.0">
            <children>
                <Label styleClass="modal-title" text="CHANGE PASSWORD" />
                <Label styleClass="modal-subtitle" text="Update your security credentials for your account." />
            </children>
        </VBox>

        <!-- MESSAGE / ALERT LABEL -->
        <Label fx:id="lblDialogMessage" managed="false" styleClass="message-label" visible="false" />

        <Separator />

        <!-- PASSWORD FORM FIELDS -->
        <VBox spacing="14.0">
            <children>
                <!-- CURRENT PASSWORD -->
                <VBox spacing="6.0">
                    <children>
                        <Label styleClass="form-label" text="CURRENT PASSWORD" />
                        <PasswordField fx:id="txtCurrentPassword" promptText="Enter current password" styleClass="form-control" />
                    </children>
                </VBox>

                <!-- NEW PASSWORD -->
                <VBox spacing="6.0">
                    <children>
                        <Label styleClass="form-label" text="NEW PASSWORD" />
                        <PasswordField fx:id="txtNewPassword" promptText="Enter new password" styleClass="form-control" />
                    </children>
                </VBox>

                <!-- CONFIRM PASSWORD -->
                <VBox spacing="6.0">
                    <children>
                        <Label styleClass="form-label" text="CONFIRM PASSWORD" />
                        <PasswordField fx:id="txtConfirmPassword" promptText="Re-enter new password" styleClass="form-control" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- ACTION BUTTONS -->
        <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-padding: 10px 0 0 0;">
            <children>
                <Button onAction="#handleCancel" styleClass="btn-cancel" text="Cancel" />
                <Button onAction="#handleSavePassword" styleClass="btn-primary" text="Update Password" />
            </children>
        </HBox>

    </children>
</VBox>